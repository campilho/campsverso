{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts://realtime/welcome.v1",
  "title": "RealtimeWelcomeV1",
  "description": "Primeira mensagem do gateway para a UI: o estado do mundo e a linha do tempo recente (ADR-0050).",
  "x-message": "campsverso.realtime.welcome.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "worldid",
    "view",
    "avatar_id",
    "commands",
    "state",
    "events"
  ],
  "properties": {
    "type": {
      "const": "campsverso.realtime.welcome.v1"
    },
    "worldid": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "view": {
      "enum": [
        "player",
        "operator"
      ],
      "description": "player: world e agent do avatar; operator: também internal e observer."
    },
    "avatar_id": {
      "$ref": "contracts://common/defs.v1#/$defs/entity_id",
      "description": "O avatar que esta conexão acompanha."
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "date"
      ],
      "description": "A versão do código que o gateway roda (ADR-0083), quando o supervisor a diz: a placa da parede e o HUD. Sem ela, a tela não mostra placa.",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      }
    },
    "commands": {
      "type": "array",
      "uniqueItems": true,
      "description": "Tipos de comando que esta conexão pode mandar.",
      "items": {
        "type": "string",
        "pattern": "^campsverso\\.cmd\\.[a-z0-9_]+(\\.[a-z0-9_]+)+\\.v[0-9]+$"
      }
    },
    "state": {
      "type": "object",
      "title": "ObserverState",
      "description": "O mundo como se vê de fora, montado só com eventos publicados (ADR-0050). Genérico e sem nada de desenho: posições em tiles, trajetos em ticks, o que é do cartucho chega como atributo. Não carrega null: atributo nulo é atributo ausente, porque no merge patch null apaga.",
      "additionalProperties": false,
      "required": [
        "tick",
        "day",
        "phase",
        "clock",
        "weather",
        "entities",
        "containers",
        "motion",
        "actions",
        "needs",
        "asleep",
        "controllers",
        "decisions"
      ],
      "properties": {
        "cartridge": {
          "$ref": "contracts://common/defs.v1#/$defs/token",
          "description": "Cartucho do mundo, como no envelope."
        },
        "tick": {
          "$ref": "contracts://common/defs.v1#/$defs/tick"
        },
        "sim_time": {
          "type": "string",
          "format": "date-time",
          "description": "Hora simulada do tick mais recente."
        },
        "day": {
          "$ref": "contracts://common/defs.v1#/$defs/day"
        },
        "phase": {
          "$ref": "contracts://common/defs.v1#/$defs/token",
          "description": "Fase do dia; `desconhecida` antes do primeiro evento de fase."
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "A data do calendário do ano acelerado (ADR-0067), da última mudança de fase; ausente sem ano declarado."
        },
        "season": {
          "$ref": "contracts://common/defs.v1#/$defs/token",
          "description": "A estação da data; ausente sem ano declarado."
        },
        "session": {
          "type": "object",
          "title": "ObserverSession",
          "additionalProperties": false,
          "required": [
            "cartridge_version"
          ],
          "properties": {
            "cartridge_version": {
              "$ref": "contracts://common/defs.v1#/$defs/semver"
            },
            "tick_seconds": {
              "type": "integer",
              "minimum": 1,
              "description": "O passo em segundos inteiros, quando cabe neles; num tick menor, vem `tick_ms` (ADR-0081)."
            },
            "tick_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000,
              "description": "O passo, em milissegundos simulados (ADR-0081). Vem sempre do gateway novo."
            },
            "screen_tiles_per_second": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "O passo de tela (ADR-0079): quantos tiles um avatar anda por segundo na tela, em qualquer escala. A tela anda nesse ritmo com o teclado; sem ele, o andar é do relógio do mundo."
            },
            "map": {
              "type": "object",
              "title": "ObserverMap",
              "additionalProperties": false,
              "description": "O mapa do cartucho; o arquivo fica no gateway em /content/maps/<id>.tmj (ADR-0050).",
              "required": [
                "id",
                "width",
                "height"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9_-]+$"
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                },
                "rows": {
                  "$ref": "contracts://common/defs.v1#/$defs/terrain_rows",
                  "description": "O terreno, como o kernel publicou no session.started (ADR-0056)."
                },
                "legend": {
                  "$ref": "contracts://common/defs.v1#/$defs/terrain_legend"
                }
              }
            },
            "affordances": {
              "type": "array",
              "items": {
                "$ref": "contracts://common/defs.v1#/$defs/affordance"
              },
              "description": "O catálogo de ações do session.started, para montar os menus (ADR-0051)."
            },
            "metrics": {
              "type": "array",
              "items": {
                "$ref": "contracts://common/defs.v1#/$defs/metric"
              },
              "description": "O catálogo de métricas do session.started (ADR-0054)."
            },
            "labels": {
              "type": "array",
              "items": {
                "$ref": "contracts://common/defs.v1#/$defs/event_label"
              },
              "description": "Os rótulos da linha do tempo do session.started (ADR-0068)."
            },
            "perception": {
              "$ref": "contracts://common/defs.v1#/$defs/perception_config"
            },
            "items": {
              "type": "object",
              "description": "O peso de cada item, para a tela desenhar o que ocupa num contêiner (M21).",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "weight"
                ],
                "properties": {
                  "weight": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "clock": {
          "type": "object",
          "title": "ObserverClock",
          "additionalProperties": false,
          "description": "Vazio até o session.started; a pausa é estado, não modo (ADR-0026).",
          "properties": {
            "mode": {
              "$ref": "contracts://common/defs.v1#/$defs/clock_mode"
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "paused": {
              "type": "boolean"
            }
          }
        },
        "pulse": {
          "type": "object",
          "title": "ObserverPulse",
          "additionalProperties": false,
          "description": "O último pulso do kernel (ADR-0051): o tick de verdade, mesmo sem evento. `alive` vira falso depois de 3 pulsos perdidos. Ausente até o primeiro pulso.",
          "required": [
            "tick",
            "alive"
          ],
          "properties": {
            "tick": {
              "$ref": "contracts://common/defs.v1#/$defs/tick"
            },
            "sim_time": {
              "type": "string",
              "format": "date-time"
            },
            "alive": {
              "type": "boolean"
            }
          }
        },
        "weather": {
          "type": "object",
          "description": "Condição do clima por dia (a chave é o número do dia).",
          "propertyNames": {
            "pattern": "^[1-9][0-9]*$"
          },
          "additionalProperties": {
            "$ref": "contracts://common/defs.v1#/$defs/token"
          }
        },
        "entities": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "title": "ObserverEntity",
            "additionalProperties": false,
            "required": [
              "kind",
              "attributes"
            ],
            "properties": {
              "kind": {
                "$ref": "contracts://common/defs.v1#/$defs/token",
                "description": "Tipo definido pelo cartucho; cada renderer escolhe como desenhar."
              },
              "position": {
                "$ref": "contracts://common/defs.v1#/$defs/position",
                "description": "Onde está, ou onde vai estar ao fim do trajeto em `motion`."
              },
              "container_id": {
                "$ref": "contracts://common/defs.v1#/$defs/entity_id",
                "description": "Dentro de outra entidade (inventário), sem posição."
              },
              "display_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "attributes": {
                "$ref": "contracts://common/defs.v1#/$defs/attributes"
              }
            }
          }
        },
        "containers": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "motion": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "title": "ObserverMotion",
            "additionalProperties": false,
            "description": "Trajeto em andamento: tile a tile, a partir de depart_tick, a tiles_per_tick.",
            "required": [
              "path",
              "depart_tick",
              "tiles_per_tick"
            ],
            "properties": {
              "path": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "contracts://common/defs.v1#/$defs/position"
                }
              },
              "depart_tick": {
                "$ref": "contracts://common/defs.v1#/$defs/tick"
              },
              "tiles_per_tick": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "action_id": {
                "$ref": "contracts://common/defs.v1#/$defs/action_id",
                "description": "A ação do trajeto (o do `world.entity.moved`): dois trajetos no mesmo tick são dois trajetos."
              }
            }
          }
        },
        "actions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "title": "ObserverAction",
            "additionalProperties": false,
            "required": [
              "action_id",
              "action",
              "params",
              "end_tick"
            ],
            "properties": {
              "action_id": {
                "$ref": "contracts://common/defs.v1#/$defs/action_id"
              },
              "action": {
                "$ref": "contracts://common/defs.v1#/$defs/token"
              },
              "params": {
                "$ref": "contracts://common/defs.v1#/$defs/params"
              },
              "end_tick": {
                "$ref": "contracts://common/defs.v1#/$defs/tick"
              },
              "applied_tick": {
                "$ref": "contracts://common/defs.v1#/$defs/tick",
                "description": "Tick em que a ação começou (ADR-0052)."
              },
              "interrupt": {
                "$ref": "contracts://common/defs.v1#/$defs/interrupt",
                "description": "O que um comando novo do mesmo controlador faz com esta ação em andamento (ADR-0052)."
              },
              "intent": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "description": "A intenção declarada na proposta aceita, quando o controlador a deu (ADR-0059)."
              }
            }
          }
        },
        "needs": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "contracts://common/defs.v1#/$defs/needs"
          },
          "description": "Último valor exato recebido de cada necessidade, por avatar."
        },
        "asleep": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "sleep": {
          "type": "object",
          "description": "O sono em andamento, por avatar: quando começou, o tick previsto para acordar e a cama, se houver (ADR-0052). Só com `sleep.started.v2`.",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "title": "ObserverSleep",
            "additionalProperties": false,
            "required": [
              "since_tick",
              "wake_at_tick"
            ],
            "properties": {
              "since_tick": {
                "$ref": "contracts://common/defs.v1#/$defs/tick"
              },
              "wake_at_tick": {
                "$ref": "contracts://common/defs.v1#/$defs/tick"
              },
              "bed_id": {
                "$ref": "contracts://common/defs.v1#/$defs/entity_id",
                "description": "A cama em que dorme; ausente quando dorme onde está."
              }
            }
          }
        },
        "controllers": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "contracts://common/defs.v1#/$defs/controller_ref"
          },
          "description": "Quem controla cada avatar."
        },
        "memory": {
          "type": "object",
          "description": "O caderno de cada avatar com controlador LLM (ADR-0060): as crenças atuais, as últimas anotações e a última reflexão, projetados dos eventos memory.*.",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "title": "ObserverMemory",
            "additionalProperties": false,
            "required": [
              "beliefs",
              "notes"
            ],
            "properties": {
              "day": {
                "$ref": "contracts://common/defs.v1#/$defs/day",
                "description": "O dia da última reflexão."
              },
              "summary": {
                "type": "string",
                "maxLength": 2000
              },
              "plan": {
                "type": "string",
                "maxLength": 1000
              },
              "beliefs": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "title": "ObserverBelief",
                  "additionalProperties": false,
                  "required": [
                    "belief_id",
                    "statement",
                    "confidence"
                  ],
                  "properties": {
                    "belief_id": {
                      "$ref": "contracts://common/defs.v1#/$defs/belief_id"
                    },
                    "statement": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "confidence": {
                      "$ref": "contracts://common/defs.v1#/$defs/confidence"
                    }
                  }
                }
              },
              "notes": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "title": "ObserverNote",
                  "additionalProperties": false,
                  "required": [
                    "tick",
                    "text"
                  ],
                  "properties": {
                    "tick": {
                      "$ref": "contracts://common/defs.v1#/$defs/tick"
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 500
                    }
                  }
                }
              }
            }
          }
        },
        "costs": {
          "type": "object",
          "title": "ObserverCosts",
          "description": "O que as chamadas de modelo custaram (ADR-0074), projetado dos eventos llm.call.completed cobrados e dos avisos ops.budget.*: por controlador, o gasto do último dia com chamadas e o total; e o último aviso do orçamento. Só a visão do operador o vê; e o sinal de vida da guarda (ADR-0080).",
          "additionalProperties": false,
          "properties": {
            "minds": {
              "type": "object",
              "description": "Por id de controlador (llm/camps…).",
              "propertyNames": {
                "minLength": 1,
                "maxLength": 128
              },
              "additionalProperties": {
                "type": "object",
                "title": "ObserverMindCost",
                "additionalProperties": false,
                "required": [
                  "day",
                  "day_usd",
                  "total_usd",
                  "calls"
                ],
                "properties": {
                  "avatar_id": {
                    "$ref": "contracts://common/defs.v1#/$defs/entity_id"
                  },
                  "model": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "day": {
                    "$ref": "contracts://common/defs.v1#/$defs/day",
                    "description": "O último dia com chamadas cobradas."
                  },
                  "day_usd": {
                    "type": "number",
                    "minimum": 0,
                    "description": "O gasto desse dia."
                  },
                  "total_usd": {
                    "type": "number",
                    "minimum": 0,
                    "description": "O gasto desde o começo."
                  },
                  "calls": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Chamadas cobradas."
                  },
                  "advisor_usd": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Do total, o que foi do conselheiro."
                  }
                }
              }
            },
            "budget": {
              "type": "object",
              "title": "ObserverBudget",
              "description": "O último aviso da guarda de orçamento (ADR-0058; o teto por pedido, ADR-0080).",
              "additionalProperties": false,
              "required": [
                "scope",
                "spent_usd",
                "limit_usd",
                "exceeded"
              ],
              "properties": {
                "scope": {
                  "type": "string",
                  "maxLength": 64
                },
                "day": {
                  "$ref": "contracts://common/defs.v1#/$defs/day"
                },
                "ticket_id": {
                  "$ref": "contracts://common/defs.v1#/$defs/entity_id",
                  "description": "O pedido, quando o escopo é ticket (ADR-0080)."
                },
                "spent_usd": {
                  "type": "number",
                  "minimum": 0
                },
                "limit_usd": {
                  "type": "number",
                  "minimum": 0
                },
                "threshold_pct": {
                  "type": "number",
                  "minimum": 0
                },
                "exceeded": {
                  "type": "boolean",
                  "description": "Bateu no teto."
                },
                "paused": {
                  "type": "boolean",
                  "description": "A guarda pausou o mundo."
                }
              }
            },
            "guard": {
              "type": "object",
              "title": "ObserverGuard",
              "additionalProperties": false,
              "description": "O último sinal de vida da guarda de orçamento (ADR-0080): os tetos de agora, o gasto e o que está estourado. `alive` vira falso depois de 3 sinais perdidos. Ausente até o primeiro sinal.",
              "required": [
                "alive",
                "limits",
                "spent_total_usd",
                "exceeded"
              ],
              "properties": {
                "alive": {
                  "type": "boolean"
                },
                "limits": {
                  "type": "object",
                  "title": "ObserverGuardLimits",
                  "additionalProperties": false,
                  "required": [
                    "usd_per_sim_day",
                    "usd_total"
                  ],
                  "properties": {
                    "usd_per_sim_day": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "description": "O teto de cada dia simulado."
                    },
                    "usd_per_ticket": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "description": "O teto de cada pedido do escritório (ADR-0080)."
                    },
                    "usd_total": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "description": "O teto do mundo inteiro."
                    }
                  }
                },
                "spent_total_usd": {
                  "type": "number",
                  "minimum": 0
                },
                "spent_day_usd": {
                  "type": "number",
                  "minimum": 0
                },
                "day": {
                  "$ref": "contracts://common/defs.v1#/$defs/day"
                },
                "exceeded": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "maxItems": 64
                }
              }
            }
          }
        },
        "workshop": {
          "type": "object",
          "title": "ObserverWorkshop",
          "description": "A oficina do dev (ADR-0080), projetada dos eventos workshop.*: o último passo de cada dev, que acende o monitor da mesa (lendo, testes verdes ou vermelhos), e a última chamada de cada robô, que o anima na bancada.",
          "additionalProperties": false,
          "properties": {
            "steps": {
              "type": "object",
              "description": "Por avatar: o último passo dele na oficina.",
              "propertyNames": {
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "additionalProperties": {
                "type": "object",
                "title": "ObserverWorkshopStep",
                "additionalProperties": false,
                "required": [
                  "ticket_id",
                  "tool",
                  "ok",
                  "tick"
                ],
                "properties": {
                  "ticket_id": {
                    "$ref": "contracts://common/defs.v1#/$defs/entity_id"
                  },
                  "tool": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "description": "A ferramenta do passo (as do workshop.step.v1)."
                  },
                  "ok": {
                    "type": "boolean"
                  },
                  "tick": {
                    "$ref": "contracts://common/defs.v1#/$defs/tick",
                    "description": "O tick em que o passo chegou."
                  }
                }
              }
            },
            "robots": {
              "type": "object",
              "description": "Por robô da bancada: a última chamada dele.",
              "propertyNames": {
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "additionalProperties": {
                "type": "object",
                "title": "ObserverWorkshopRobot",
                "additionalProperties": false,
                "required": [
                  "state",
                  "avatar_id",
                  "tick"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "working",
                      "passed",
                      "failed"
                    ],
                    "description": "Rodando (entre o robot_started e o robot_called), ou o resultado."
                  },
                  "avatar_id": {
                    "$ref": "contracts://common/defs.v1#/$defs/entity_id",
                    "description": "Quem o chamou."
                  },
