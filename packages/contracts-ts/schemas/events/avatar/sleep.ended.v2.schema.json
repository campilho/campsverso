{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts://events/avatar/sleep.ended.v2",
  "title": "AvatarSleepEndedV2",
  "description": "O avatar acordou (ADR-0014, ADR-0041, ADR-0042).",
  "x-type": "campsverso.avatar.sleep.ended.v2",
  "x-visibility": "world",
  "x-producer": "kernel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "avatar_id",
    "cause",
    "energy"
  ],
  "properties": {
    "avatar_id": {
      "$ref": "contracts://common/defs.v1#/$defs/entity_id",
      "description": "Avatar (o corpo), independente de quem o controla (ADR-0027)."
    },
    "cause": {
      "enum": [
        "voluntary",
        "faint"
      ],
      "description": "voluntary: o controlador mandou dormir; faint: desmaio."
    },
    "bed_id": {
      "$ref": "contracts://common/defs.v1#/$defs/entity_id",
      "description": "Cama ou entidade análoga usada no sono. Ausente quando o avatar dormiu onde estava."
    },
    "energy": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  }
}
