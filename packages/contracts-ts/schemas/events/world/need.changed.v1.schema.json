{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts://events/world/need.changed.v1",
  "title": "WorldNeedChangedV1",
  "description": "Valor de uma necessidade; no máximo um por hora simulada por necessidade.",
  "x-type": "campsverso.world.need.changed.v1",
  "x-visibility": "agent",
  "x-producer": "kernel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "avatar_id",
    "need",
    "previous_value",
    "value"
  ],
  "properties": {
    "avatar_id": {
      "$ref": "contracts://common/defs.v1#/$defs/entity_id",
      "description": "Avatar (o corpo), independente de quem o controla (ADR-0027)."
    },
    "need": {
      "$ref": "contracts://common/defs.v1#/$defs/token",
      "description": "Ex.: fome, energia."
    },
    "previous_value": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "value": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  }
}
