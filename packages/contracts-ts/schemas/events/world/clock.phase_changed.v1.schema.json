{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts://events/world/clock.phase_changed.v1",
  "title": "WorldClockPhaseChangedV1",
  "description": "Mudança de fase do dia; os nomes das fases vêm do cartucho.",
  "x-type": "campsverso.world.clock.phase_changed.v1",
  "x-visibility": "world",
  "x-producer": "kernel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phase",
    "day"
  ],
  "properties": {
    "phase": {
      "$ref": "contracts://common/defs.v1#/$defs/token",
      "description": "Ex.: amanhecer, meio_dia, entardecer, noite, madrugada."
    },
    "day": {
      "$ref": "contracts://common/defs.v1#/$defs/day"
    }
  }
}
