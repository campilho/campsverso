{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts://events/world/clock.caught_up.v1",
  "title": "WorldClockCaughtUpV1",
  "description": "O relógio ancorado no real alcançou o tick de agora (ADR-0078): o mundo andou de `from_tick` a `to_tick` de uma vez, ao subir de novo.",
  "x-type": "campsverso.world.clock.caught_up.v1",
  "x-visibility": "world",
  "x-producer": "kernel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "from_tick",
    "to_tick",
    "reason"
  ],
  "properties": {
    "from_tick": {
      "$ref": "contracts://common/defs.v1#/$defs/tick"
    },
    "to_tick": {
      "$ref": "contracts://common/defs.v1#/$defs/tick"
    },
    "reason": {
      "$ref": "contracts://common/defs.v1#/$defs/token"
    }
  }
}
