{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts://events/world/snapshot.created.v1",
  "title": "WorldSnapshotCreatedV1",
  "description": "Snapshot persistido no BlobStore.",
  "x-type": "campsverso.world.snapshot.created.v1",
  "x-visibility": "internal",
  "x-producer": "kernel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "ref",
    "last_seq",
    "sha256",
    "size_bytes"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "last_seq": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    }
  }
}
