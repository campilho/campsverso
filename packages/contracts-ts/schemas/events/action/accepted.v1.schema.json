{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts://events/action/accepted.v1",
  "title": "ActionAcceptedV1",
  "description": "Ação validada e agendada; applied_tick permite o replay exato.",
  "x-type": "campsverso.action.accepted.v1",
  "x-visibility": "world",
  "x-producer": "kernel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "avatar_id",
    "action",
    "params",
    "applied_tick",
    "duration_ticks"
  ],
  "properties": {
    "action_id": {
      "$ref": "contracts://common/defs.v1#/$defs/action_id"
    },
    "avatar_id": {
      "$ref": "contracts://common/defs.v1#/$defs/entity_id",
      "description": "Avatar (o corpo), independente de quem o controla (ADR-0027)."
    },
    "action": {
      "$ref": "contracts://common/defs.v1#/$defs/token"
    },
    "params": {
      "$ref": "contracts://common/defs.v1#/$defs/params"
    },
    "applied_tick": {
      "$ref": "contracts://common/defs.v1#/$defs/tick"
    },
    "duration_ticks": {
      "type": "integer",
      "minimum": 0,
      "description": "Duração prevista."
    },
    "replaces": {
      "$ref": "contracts://common/defs.v1#/$defs/action_id",
      "description": "Ação em andamento cancelada por esta."
    }
  }
}
