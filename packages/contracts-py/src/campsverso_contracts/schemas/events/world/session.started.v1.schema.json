{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts://events/world/session.started.v1",
  "title": "WorldSessionStartedV1",
  "description": "Mundo carregado ou retomado a partir de snapshot.",
  "x-type": "campsverso.world.session.started.v1",
  "x-visibility": "world",
  "x-producer": "kernel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cartridge_version",
    "seed",
    "tick_seconds",
    "mode",
    "paused",
    "scale",
    "resumed",
    "map"
  ],
  "properties": {
    "cartridge_version": {
      "$ref": "contracts://common/defs.v1#/$defs/semver"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "description": "Seed registrada; os fluxos de RNG nomeados derivam dela."
    },
    "tick_seconds": {
      "type": "integer",
      "minimum": 1,
      "description": "Duração de um tick em segundos simulados."
    },
    "mode": {
      "$ref": "contracts://common/defs.v1#/$defs/clock_mode"
    },
    "paused": {
      "type": "boolean"
    },
    "scale": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Segundos simulados por segundo real."
    },
    "resumed": {
      "type": "boolean",
      "description": "Verdadeiro quando o mundo foi retomado a partir de snapshot."
    },
    "map": {
      "type": "object",
      "title": "SessionMap",
      "additionalProperties": false,
      "required": [
        "id",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9_-]+$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "rows": {
          "$ref": "contracts://common/defs.v1#/$defs/terrain_rows",
          "description": "O terreno do mapa inteiro, publicado uma vez (ADR-0056): quem decide passa a enxergar onde pode pisar."
        },
        "legend": {
          "$ref": "contracts://common/defs.v1#/$defs/terrain_legend"
        }
      }
    },
    "affordances": {
      "type": "array",
      "items": {
        "$ref": "contracts://common/defs.v1#/$defs/affordance"
      },
      "description": "Catálogo de ações que o cartucho oferece a quem joga (ADR-0051). O menu só sugere; quem decide é o kernel."
    },
    "metrics": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "contracts://common/defs.v1#/$defs/metric"
      },
      "description": "Catálogo de métricas do dia que o cartucho declara (ADR-0054)."
    },
    "labels": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "contracts://common/defs.v1#/$defs/event_label"
      },
      "description": "Os rótulos da linha do tempo que o cartucho declara (ADR-0068)."
    },
    "perception": {
      "$ref": "contracts://common/defs.v1#/$defs/perception_config",
      "description": "O raio de percepção declarado pelo cartucho; vale para todos os atores (ADR-0056)."
    },
    "items": {
      "type": "object",
      "description": "O peso de cada item, para a tela desenhar o que ocupa num contêiner (M21).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "weight"
        ],
        "properties": {
          "weight": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
