{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts://events/world/entity.move_interrupted.v1",
  "title": "WorldEntityMoveInterruptedV1",
  "description": "Movimento interrompido; traz a posição real no momento (D1).",
  "x-type": "campsverso.world.entity.move_interrupted.v1",
  "x-visibility": "world",
