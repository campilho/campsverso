{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts://events/action/rejected.v1",
  "title": "ActionRejectedV1",
  "description": "Ação recusada, com motivo legível por máquina.",
  "x-type": "campsverso.action.rejected.v1",
  "x-visibility": "agent",
  "x-producer": "kernel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "avatar_id",
    "action",
    "params",
    "reason"
  ],
  "properties": {
    "avatar_id": {
      "$ref": "contracts://common/defs.v1#/$defs/entity_id",
      "description": "Avatar (o corpo), independente de quem o controla (ADR-0027)."
    },
    "action": {
      "$ref": "contracts://common/defs.v1#/$defs/token"
    },
    "params": {
      "$ref": "contracts://common/defs.v1#/$defs/params"
    },
    "reason": {
      "$ref": "contracts://common/defs.v1#/$defs/token",
      "description": "Ex.: not_in_control, not_adjacent, missing_item, closed, not_ripe."
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
