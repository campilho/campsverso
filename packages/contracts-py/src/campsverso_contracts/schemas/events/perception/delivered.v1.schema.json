{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts://events/perception/delivered.v1",
  "title": "PerceptionDeliveredV1",
  "description": "Instantâneo do que o avatar percebe, a cada pedido de decisão (ADR-0028).",
  "x-type": "campsverso.perception.delivered.v1",
  "x-visibility": "agent",
  "x-producer": "perception",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "avatar_id",
    "kind",
    "as_of_tick",
    "view"
  ],
  "properties": {
    "avatar_id": {
      "$ref": "contracts://common/defs.v1#/$defs/entity_id",
      "description": "Avatar (o corpo), independente de quem o controla (ADR-0027)."
    },
    "kind": {
      "enum": [
        "snapshot"
      ]
    },
    "as_of_tick": {
      "$ref": "contracts://common/defs.v1#/$defs/tick"
    },
    "view": {
      "type": "object",
      "title": "PerceptionView",
      "description": "Visão genérica: o que é da fazenda chega como atributo de entidade (ADR-0025).",
      "additionalProperties": false,
      "required": [
        "clock",
        "weather",
        "self",
        "containers",
        "entities"
      ],
      "properties": {
        "clock": {
          "type": "object",
          "title": "ViewClock",
          "additionalProperties": false,
          "required": [
            "tick",
            "sim_time",
            "day",
            "phase"
          ],
          "properties": {
            "tick": {
              "$ref": "contracts://common/defs.v1#/$defs/tick"
            },
            "sim_time": {
              "type": "string",
              "format": "date-time"
            },
            "day": {
              "$ref": "contracts://common/defs.v1#/$defs/day"
            },
            "phase": {
              "$ref": "contracts://common/defs.v1#/$defs/token"
            }
          }
        },
        "weather": {
          "type": "object",
          "title": "ViewWeather",
          "additionalProperties": false,
          "required": [
            "condition",
            "day"
          ],
          "properties": {
            "condition": {
              "$ref": "contracts://common/defs.v1#/$defs/token"
            },
            "day": {
              "$ref": "contracts://common/defs.v1#/$defs/day"
            }
          }
        },
        "self": {
          "type": "object",
          "title": "ViewSelf",
          "additionalProperties": false,
          "required": [
            "entity_id",
            "position",
            "needs",
            "asleep"
          ],
          "properties": {
            "entity_id": {
              "$ref": "contracts://common/defs.v1#/$defs/entity_id"
            },
            "position": {
              "$ref": "contracts://common/defs.v1#/$defs/position"
            },
            "needs": {
              "$ref": "contracts://common/defs.v1#/$defs/needs"
            },
            "asleep": {
              "type": "boolean"
            },
            "action": {
              "type": "object",
              "title": "ViewAction",
              "additionalProperties": false,
              "required": [
                "action_id",
                "action",
                "params",
                "end_tick"
              ],
              "properties": {
                "action_id": {
                  "$ref": "contracts://common/defs.v1#/$defs/action_id"
                },
                "action": {
                  "$ref": "contracts://common/defs.v1#/$defs/token"
                },
                "params": {
                  "$ref": "contracts://common/defs.v1#/$defs/params"
                },
                "end_tick": {
                  "$ref": "contracts://common/defs.v1#/$defs/tick"
                }
              }
            }
          }
        },
        "containers": {
          "type": "array",
          "items": {
            "type": "object",
            "title": "ViewContainer",
            "additionalProperties": false,
            "required": [
              "container_id",
              "items"
            ],
            "properties": {
              "container_id": {
                "$ref": "contracts://common/defs.v1#/$defs/entity_id"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "contracts://common/defs.v1#/$defs/item_stack"
                }
              }
            }
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "title": "ViewEntity",
            "additionalProperties": false,
            "required": [
              "entity_id",
              "kind",
              "attributes"
            ],
            "properties": {
              "entity_id": {
                "$ref": "contracts://common/defs.v1#/$defs/entity_id"
              },
              "kind": {
                "$ref": "contracts://common/defs.v1#/$defs/token"
              },
              "position": {
                "$ref": "contracts://common/defs.v1#/$defs/position"
              },
              "container_id": {
                "$ref": "contracts://common/defs.v1#/$defs/entity_id"
              },
              "attributes": {
                "$ref": "contracts://common/defs.v1#/$defs/attributes"
              }
            }
          }
        }
      }
    }
  }
}
