{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts://events/memory/belief.retracted.v1",
  "title": "MemoryBeliefRetractedV1",
  "description": "O agente abandonou uma crença (ADR-0060; contratos §8.4).",
  "x-type": "campsverso.memory.belief.retracted.v1",
  "x-visibility": "observer",
  "x-producer": "controller",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "avatar_id",
    "belief_id",
    "statement"
  ],
  "properties": {
    "avatar_id": {
      "$ref": "contracts://common/defs.v1#/$defs/entity_id",
      "description": "O avatar cuja memória é esta."
    },
    "belief_id": {
      "$ref": "contracts://common/defs.v1#/$defs/belief_id"
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "A crença, em uma frase."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Por que a reflexão fez isso."
    }
  }
}
