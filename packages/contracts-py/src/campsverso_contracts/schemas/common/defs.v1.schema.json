{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts://common/defs.v1",
  "title": "CommonDefsV1",
  "description": "Tipos comuns usados pelos schemas de eventos e comandos (catálogo da v0.1, seção 1.4).",
  "$defs": {
    "uuid7": {
      "title": "Uuid7",
      "description": "UUID versão 7 (RFC 9562), ordenável por tempo.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "entity_id": {
      "title": "EntityId",
      "description": "Id legível e estável de uma entidade: camps, plot-e-03, bed.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "item_id": {
      "title": "ItemId",
      "description": "Id de item ou cultura; conteúdo do cartucho, em português, sem acento: moeda, semente_rabanete.",
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
      "maxLength": 64
    },
    "action_id": {
      "title": "ActionId",
      "description": "Id de ação: contador determinístico do kernel.",
      "type": "string",
      "pattern": "^act-[0-9]{6,}$"
    },
    "token": {
      "title": "Token",
      "description": "Nome definido pelo cartucho ou pelo kernel: ação, fase, estágio, necessidade, tipo de entidade, motivo.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64
    },
    "semver": {
      "title": "Semver",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "actor": {
      "title": "Actor",
      "description": "Quem causou: human/operator, script/farmer-v1, system/kernel.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tick": {
      "title": "Tick",
      "description": "Tick do kernel (1 minuto simulado na fazenda).",
      "type": "integer",
      "minimum": 0
    },
    "day": {
      "title": "Day",
      "description": "Dia simulado (dia agrícola, ADR-0018), começando em 1.",
      "type": "integer",
      "minimum": 1
    },
    "position": {
      "title": "Position",
      "description": "Posição em tiles.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "item_stack": {
      "title": "ItemStack",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "qty"
      ],
      "properties": {
        "item": {
          "$ref": "#/$defs/item_id"
        },
        "qty": {
          "type": "integer",
          "minimum": 1
        },
        "expires_in_days": {
          "type": "integer",
          "description": "Dias até o lote mais antigo vencer pela validade nominal, quando o item tem validade (ADR-0062); zero vence hoje, negativo já passou da data e ainda não estragou (o contêiner conserva)."
        }
      }
    },
    "controller_type": {
      "title": "ControllerType",
      "enum": [
        "human",
        "script",
        "replay",
        "llm",
        "mcp",
        "supervised"
      ]
    },
    "controller_ref": {
      "title": "ControllerRef",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/controller_type"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "clock_mode": {
      "title": "ClockMode",
      "description": "Modos do relógio na v0.1; a pausa é um estado à parte (ADR-0026).",
      "enum": [
        "continuous",
        "max"
      ]
    },
    "scalar": {
      "title": "Scalar",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "attributes": {
      "title": "Attributes",
      "description": "Atributos visíveis de uma entidade (ADR-0025): nomes em snake_case, valores escalares.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/scalar"
      }
    },
    "needs": {
      "title": "Needs",
      "description": "Valor atual de cada necessidade (0 a 100), pelo nome definido no cartucho.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    },
    "params": {
      "title": "Params",
      "description": "Parâmetros de uma ação. A forma depende da ação e é validada pelo cartucho, não por este schema.",
      "type": "object",
      "additionalProperties": {}
    },
    "affordance_param": {
      "title": "AffordanceParam",
      "description": "Um parâmetro que quem joga escolhe (ADR-0051). Sem `choices`, é um número inteiro.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "source"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/token",
          "description": "O nome do parâmetro na ação (crop, item, qty…)."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "uniqueItems": true
        },
        "source": {
          "enum": [
            "any",
            "inventory",
            "target"
          ],
          "description": "Onde as escolhas valem: a lista toda, o que o avatar tem ou o que a entidade clicada guarda."
        },
        "minimum": {
          "type": "integer"
        },
        "default": {
          "type": "integer"
        }
      }
    },
    "affordance": {
      "title": "Affordance",
      "description": "Uma ação no menu de um tipo de entidade, ou do próprio avatar (`self`). O menu só sugere; quem decide é o kernel (ADR-0051).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "label",
        "on",
        "target"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/token"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "on": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/token"
          },
          "description": "Tipos de entidade em que a ação aparece; `self` é o próprio avatar."
        },
        "target": {
          "type": "boolean",
          "description": "A entidade clicada vai no parâmetro `target`."
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/affordance_param"
          }
        }
      }
    },
    "interrupt": {
      "title": "Interrupt",
      "description": "Política de interrupção de uma ação (ADR-0052): `never`, um comando novo é recusado com `busy`; `cancel`, cancela a ação e nada dela acontece; `partial`, interrompe e o cartucho grava o trabalho feito.",
      "type": "string",
      "enum": [
        "never",
        "cancel",
        "partial"
      ]
    },
    "metric": {
      "title": "Metric",
      "description": "Uma métrica do dia simulado, declarada pelo cartucho e contada pela projeção comum (ADR-0054). `count` conta um tipo de evento; `max_need` guarda o pico de uma necessidade; `item` guarda a quantidade de um item com os avatares no fim do dia.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "kind": {
          "type": "string",
          "enum": [
            "count",
            "max_need",
            "item"
          ]
        },
        "event": {
          "type": "string",
          "pattern": "^campsverso\\.[a-z0-9_]+(\\.[a-z0-9_]+)*\\.v[0-9]+$",
          "description": "O tipo de evento contado (`count`)."
        },
        "where": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/scalar"
          },
          "description": "Campos do evento que precisam bater; caminhos com ponto (`params.target`)."
        },
        "by": {
          "type": "object",
          "title": "MetricGroup",
          "additionalProperties": false,
          "required": [
            "field"
          ],
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
            },
            "attribute": {
              "$ref": "#/$defs/token",
              "description": "Agrupa pelo atributo da entidade cujo id está no campo (o `group` do canteiro)."
            }
          }
        },
        "need": {
          "$ref": "#/$defs/token",
          "description": "A necessidade (`max_need`)."
        },
        "item": {
          "$ref": "#/$defs/item_id",
          "description": "O item (`item`)."
        }
      }
    },
    "seen_clock": {
      "title": "SeenClock",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tick",
        "sim_time",
        "day",
        "phase"
      ],
      "properties": {
        "tick": {
          "$ref": "#/$defs/tick"
        },
        "sim_time": {
          "type": "string",
          "format": "date-time"
        },
        "day": {
          "$ref": "#/$defs/day"
        },
        "phase": {
          "$ref": "#/$defs/token"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "A data do calendário do ano acelerado (ADR-0067), à parte do simtime; ausente sem ano declarado."
        },
        "season": {
          "$ref": "#/$defs/token",
          "description": "A estação da data (primavera, verao…), declarada pelo cartucho; ausente sem ano declarado."
        }
      }
    },
    "seen_weather": {
      "title": "SeenWeather",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "day"
      ],
      "properties": {
        "condition": {
          "$ref": "#/$defs/token"
        },
        "day": {
          "$ref": "#/$defs/day"
        }
      }
    },
    "seen_action": {
      "title": "SeenAction",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "action",
        "params",
        "end_tick"
      ],
      "properties": {
        "action_id": {
          "$ref": "#/$defs/action_id"
        },
        "action": {
          "$ref": "#/$defs/token"
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "end_tick": {
          "$ref": "#/$defs/tick"
        },
        "applied_tick": {
          "$ref": "#/$defs/tick",
          "description": "Tick em que a ação começou (ADR-0052)."
        },
        "interrupt": {
          "$ref": "#/$defs/interrupt",
          "description": "O que um comando novo do mesmo controlador faz com esta ação em andamento (ADR-0052)."
        }
      }
    },
    "seen_self": {
      "title": "SeenSelf",
      "description": "O próprio avatar: posição, necessidades, se dorme e a ação em curso.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "position",
        "needs",
        "asleep"
      ],
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/entity_id"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "needs": {
          "$ref": "#/$defs/needs"
        },
        "asleep": {
          "type": "boolean"
        },
        "action": {
          "$ref": "#/$defs/seen_action"
        }
      }
    },
    "seen_container": {
      "title": "SeenContainer",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_id",
        "items"
      ],
      "properties": {
        "container_id": {
          "$ref": "#/$defs/entity_id"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item_stack"
          }
        }
      }
    },
    "seen_entity": {
      "title": "SeenEntity",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "kind",
        "attributes"
      ],
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/entity_id"
        },
        "kind": {
          "$ref": "#/$defs/token"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "container_id": {
          "$ref": "#/$defs/entity_id"
        },
        "attributes": {
          "$ref": "#/$defs/attributes"
        }
      }
    },
    "decision_request": {
      "title": "DecisionRequest",
      "description": "O pedido de decisão que a entrega da percepção responde: o motivo e quem deve responder (ADR-0048).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "controller"
      ],
      "properties": {
        "reason": {
          "enum": [
            "session_started",
            "possessed",
            "action_completed",
            "action_rejected",
            "action_interrupted",
            "phase_changed",
            "need_threshold",
            "woke_up"
          ]
        },
        "controller": {
          "$ref": "#/$defs/controller_ref"
        }
      }
    },
    "seen_event": {
      "title": "SeenEvent",
      "description": "Um evento que o avatar percebeu desde a última entrega: o tick, o tipo e o payload, como foram publicados.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tick",
        "type",
        "data"
      ],
      "properties": {
        "tick": {
          "$ref": "#/$defs/tick"
        },
        "type": {
          "type": "string",
          "pattern": "^campsverso\\.[a-z0-9_]+(\\.[a-z0-9_]+)*\\.v[0-9]+$",
          "maxLength": 128
        },
        "data": {
          "type": "object",
          "additionalProperties": {}
        }
      }
    },
    "terrain_tile": {
      "title": "TerrainTile",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "properties"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z0-9_]*$",
          "maxLength": 64,
          "description": "A classe do tile no tileset (grass, river…); vazia quando o tile não tem classe."
        },
        "properties": {
          "$ref": "#/$defs/attributes",
          "description": "As propriedades do tile no tileset, como passable e water."
        }
      }
    },
    "terrain_legend": {
      "title": "TerrainLegend",
      "description": "Legenda do terreno: o que cada caractere das linhas significa (ADR-0056).",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^.$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/terrain_tile"
      }
    },
    "terrain_rows": {
      "title": "TerrainRows",
      "description": "O terreno, uma string por linha e um caractere por tile, de cima para baixo e da esquerda para a direita (ADR-0056).",
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "terrain_window": {
      "title": "TerrainWindow",
      "description": "O terreno ao alcance do avatar: as linhas a partir de origin (o canto superior esquerdo da janela), com a legenda.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "rows",
        "legend"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/position"
        },
        "rows": {
          "$ref": "#/$defs/terrain_rows"
        },
        "legend": {
          "$ref": "#/$defs/terrain_legend"
        }
      }
    },
    "perception_config": {
      "title": "PerceptionConfig",
      "description": "O que o cartucho declara sobre a percepção (ADR-0056).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radius"
      ],
      "properties": {
        "radius": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Distância de Chebyshev, em tiles, do que um avatar enxerga; null é o mapa inteiro."
        }
      }
    },
    "llm_usage": {
      "title": "LlmUsage",
      "description": "Tokens de uma chamada de modelo, como o provedor os contou (ADR-0058): entrada, saída, lidos do cache e gravados no cache.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_creation_input_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "belief_id": {
      "title": "BeliefId",
      "description": "Id de uma crença do agente (ADR-0060): bel-0001.",
      "type": "string",
      "pattern": "^bel-[0-9a-z]+(-[0-9a-z]+)*$",
      "maxLength": 64
    },
    "confidence": {
      "title": "Confidence",
      "description": "Quanto o agente acredita, de 0 a 1 (ADR-0060).",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "belief_source": {
      "title": "BeliefSource",
      "description": "De onde a crença veio (contratos §8.4): do que o agente observou, ou de quem lhe contou (`by`).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "observation",
            "told"
          ]
        },
        "by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Quem contou, quando `kind` é `told`."
        }
      }
    },
    "belief_evidence": {
      "title": "BeliefEvidence",
      "description": "Evidências de uma crença: ticks e fatos de uma linha, do que o agente percebeu; nunca o `internal`.",
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  }
}
