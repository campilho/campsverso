+def closes_at(view: WorldView) -> int:
+    """O minuto em que o expediente de hoje acaba: mais cedo na sexta, quando o cenário dá
+    `closes_friday`."""
+    rules = section(view, "schedule")
+    friday = date.fromisoformat(view.today).isoweekday() == 4
+    if friday and rules.get("closes_friday"):
+        return minutes(str(rules["closes_friday"]))
+    return minutes(str(rules["closes"]))
+
+
