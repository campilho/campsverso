diff --git a/services/kernel/tests/test_sexta_curta.py b/services/kernel/tests/test_sexta_curta.py
new file mode 100644
index 0000000..e651ab8
--- /dev/null
+++ b/services/kernel/tests/test_sexta_curta.py
@@ -0,0 +1,37 @@
+"""O expediente curto da sexta (pedido 9): o dev sai às 17:00 e o vigia entra."""
+
+from typing import Any, cast
+
+from campsverso_cartridge_api import WorldView
+from campsverso_office_sim.config import closes_at, minutes
+
+SCHEDULE = {
+    "workdays": [1, 2, 3, 4, 5],
+    "opens": "09:00",
+    "lunch": ["12:00", "13:00"],
+    "closes": "18:00",
+    "closes_friday": "17:00",
+}
+
+
+class _View:
+    """Só o que `closes_at` lê da vista do mundo."""
+
+    def __init__(self, today: str) -> None:
+        self.today = today
+        self.minute_of_day = minutes("16:30")
+
+    def data(self, namespace: str) -> dict[str, Any]:
+        return {"schedule": SCHEDULE}
+
+
+def _view(today: str) -> WorldView:
+    return cast(WorldView, _View(today))
+
+
+def test_na_sexta_o_expediente_acaba_as_17() -> None:
+    assert closes_at(_view("2026-11-19")) == minutes("17:00")  # sexta, 19/nov
+
+
+def test_nos_outros_dias_acaba_as_18() -> None:
+    assert closes_at(_view("2026-11-17")) == minutes("18:00")  # terça
