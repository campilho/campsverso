{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts://events/memory/belief.updated.v1",
  "title": "MemoryBeliefUpdatedV1",
  "description": "A confiança de uma crença mudou, ou o enunciado foi refinado (ADR-0060; contratos §8.4), com a evidência que pesou.",
  "x-type": "campsverso.memory.belief.updated.v1",
  "x-visibility": "observer",
  "x-producer": "controller",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "avatar_id",
    "belief_id",
    "statement",
    "confidence",
    "evidence",
    "source"
  ],
  "properties": {
    "avatar_id": {
      "$ref": "contracts://common/defs.v1#/$defs/entity_id",
      "description": "O avatar cuja memória é esta."
    },
    "belief_id": {
      "$ref": "contracts://common/defs.v1#/$defs/belief_id"
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "A crença, em uma frase."
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "$ref": "contracts://common/defs.v1#/$defs/confidence"
        },
        "after": {
          "$ref": "contracts://common/defs.v1#/$defs/confidence"
        }
      }
    },
    "evidence": {
      "$ref": "contracts://common/defs.v1#/$defs/belief_evidence"
    },
    "source": {
      "$ref": "contracts://common/defs.v1#/$defs/belief_source"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Por que a reflexão fez isso."
    }
  }
}
