{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts://events/economy/order.posted.v1",
  "title": "EconomyOrderPostedV1",
  "description": "Um pedido novo apareceu num quadro de encomendas (ADR-0069): quem pede, o quê, quanto, até quando e quanto paga. O pedido é uma entidade dentro do quadro.",
  "x-type": "campsverso.economy.order.posted.v1",
  "x-visibility": "world",
  "x-producer": "kernel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "board_id",
    "client",
    "item",
    "qty",
    "reward",
    "posted_day",
    "due_day"
  ],
  "properties": {
    "order_id": {
      "$ref": "contracts://common/defs.v1#/$defs/entity_id"
    },
    "board_id": {
      "$ref": "contracts://common/defs.v1#/$defs/entity_id",
      "description": "O quadro em que o pedido apareceu."
    },
    "client": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Quem pediu, como aparece no quadro (Dona Cida, a padaria da praça)."
    },
    "item": {
      "$ref": "contracts://common/defs.v1#/$defs/item_id"
    },
    "qty": {
      "type": "integer",
      "minimum": 1
    },
    "reward": {
      "type": "integer",
      "minimum": 1,
      "description": "O pagamento total, em moedas, na entrega."
    },
    "posted_day": {
      "$ref": "contracts://common/defs.v1#/$defs/day"
    },
    "due_day": {
      "$ref": "contracts://common/defs.v1#/$defs/day",
      "description": "O último dia para entregar."
    }
  }
}
