{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts://events/world/clock.stepped.v1",
  "title": "WorldClockSteppedV1",
  "description": "Avanço passo a passo com o relógio pausado.",
  "x-type": "campsverso.world.clock.stepped.v1",
  "x-visibility": "world",
  "x-producer": "kernel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticks",
    "from_tick",
    "to_tick"
  ],
  "properties": {
    "ticks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440
    },
    "from_tick": {
      "$ref": "contracts://common/defs.v1#/$defs/tick"
    },
    "to_tick": {
      "$ref": "contracts://common/defs.v1#/$defs/tick"
    }
  }
}
