{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts://events/world/item.created.v1",
  "title": "WorldItemCreatedV1",
  "description": "Item surgiu num contêiner.",
  "x-type": "campsverso.world.item.created.v1",
  "x-visibility": "world",
  "x-producer": "kernel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item",
    "qty",
    "container_id",
    "reason"
  ],
  "properties": {
    "item": {
      "$ref": "contracts://common/defs.v1#/$defs/item_id"
    },
    "qty": {
      "type": "integer",
      "minimum": 1
    },
    "container_id": {
      "$ref": "contracts://common/defs.v1#/$defs/entity_id"
    },
    "reason": {
      "$ref": "contracts://common/defs.v1#/$defs/token",
      "description": "Ex.: initial, harvest, buy, payment."
    },
    "action_id": {
      "$ref": "contracts://common/defs.v1#/$defs/action_id"
    },
    "expires_day": {
      "$ref": "contracts://common/defs.v1#/$defs/day",
      "description": "O dia em que o lote criado vence pela validade nominal do item, quando o item tem validade (ADR-0062)."
    }
  }
}
